<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="#fdf6e3"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.navegacion.PantalladerActivity">

    <!-- HEADER -->
    <Button
        android:id="@+id/btn_salir"
        android:layout_width="68dp"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#D7701D"
        android:text="X"
        android:textColor="#fdf6e3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="PreAlertarte"
        android:textColor="#0d0d0d"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Herramientas y Utilidades"
        android:textColor="#555555"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView2" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/btnmedio"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView3">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- BATERÍA: RECYCLERVIEW DE 100DP DE HEIGHT EN LA PARTE SUPERIOR QUE OCUPA TODO EL WIDTH -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvBateria"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:nestedScrollingEnabled="false"
                android:layout_marginBottom="12dp" />

            <!-- GRID DE BOTONES DE HERRAMIENTAS ABAJO -->
            <androidx.gridlayout.widget.GridLayout
                android:id="@+id/scroll_cont"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:columnCount="2"
                app:alignmentMode="alignMargins"
                app:columnOrderPreserved="false">

                <!-- 1. CÁMARA (FRONTAL / SELFIE) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp">
                    <Button
                        android:id="@+id/btn_Camara"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:backgroundTint="#D7701D"
                        android:text="📷"
                        android:textSize="28sp"
                        android:textColor="#fdf6e3" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Cámara Video"
                        android:textColor="#000000"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="center" />
                </LinearLayout>

                <!-- 2. GRABADORA DE AUDIO (PANTALLA PROPIA) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp">
                    <Button
                        android:id="@+id/btn_Grabadora"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:backgroundTint="#D7701D"
                        android:text="🎙️"
                        android:textSize="28sp"
                        android:textColor="#fdf6e3" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Grabar Audio"
                        android:textColor="#000000"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="center" />
                </LinearLayout>

                <!-- 3. CHAT ASISTENCIA -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp">
                    <Button
                        android:id="@+id/btn_Chat"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:backgroundTint="#D7701D"
                        android:text="💬"
                        android:textSize="28sp"
                        android:textColor="#fdf6e3" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Chat Asistencia"
                        android:textColor="#000000"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="center" />
                </LinearLayout>

                <!-- 4. GUÍA CATASTROFES -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp">
                    <Button
                        android:id="@+id/btn_Guia"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:backgroundTint="#D7701D"
                        android:text="📖"
                        android:textSize="28sp"
                        android:textColor="#fdf6e3" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Guía Catástrofes"
                        android:textColor="#000000"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="center" />
                </LinearLayout>

                <!-- 5. COMANDO POR VOZ (DIRECTO CON TOAST Y SPEECHRECOGNIZER DE GOOGLE) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp">
                    <Button
                        android:id="@+id/btn_Voz"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:backgroundTint="#D7701D"
                        android:text="🗣️"
                        android:textSize="28sp"
                        android:textColor="#fdf6e3" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Comando por Voz"
                        android:textColor="#000000"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="center" />
                </LinearLayout>

                <!-- 6. ALERTA PÁNICO -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp">
                    <Button
                        android:id="@+id/btn_Panico"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:backgroundTint="#C0392B"
                        android:text="🚨"
                        android:textSize="28sp"
                        android:textColor="#fdf6e3" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Simular Pánico"
                        android:textColor="#C0392B"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="center" />
                </LinearLayout>

            </androidx.gridlayout.widget.GridLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- FOOTER / NAVEGACIÓN INFERIOR -->
    <Button
        android:id="@+id/btn_izq"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#D7701D"
        android:text="mapa"
        android:textColor="#fdf6e3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnmedio"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btnmedio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#D7701D"
        android:text="home"
        android:textColor="#fdf6e3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn_der"
        app:layout_constraintStart_toEndOf="@+id/btn_izq" />

    <Button
        android:id="@+id/btn_der"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#D7701D"
        android:text="apps"
        android:textColor="#fdf6e3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btnmedio" />

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="#fdf6e3"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.comandovoz.VoiceActivity">

    <!-- HEADER -->
    <Button
        android:id="@+id/btn_salir"
        android:layout_width="68dp"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#D7701D"
        android:text="X"
        android:textColor="#fdf6e3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="PreAlertarte"
        android:textColor="#0d0d0d"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Grabadora de Voz"
        android:textColor="#555555"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView2" />

    <LinearLayout
        android:id="@+id/containerContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@+id/textView3"
        app:layout_constraintBottom_toTopOf="@+id/btnmedio"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎙️ Grabación de Audio"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#0d0d0d" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Graba notas de audio con el micrófono del teléfono. Los archivos se guardarán localmente."
            android:textColor="#666666"
            android:textSize="14sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvAudioStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Listo para grabar"
            android:textColor="#D7701D"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnRecordAudio"
            android:layout_width="220dp"
            android:layout_height="64dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#D7701D"
            android:text="Iniciar Grabación"
            android:textColor="#fdf6e3"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- FOOTER / NAVEGACIÓN INFERIOR -->
    <Button
        android:id="@+id/btn_izq"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#D7701D"
        android:text="mapa"
        android:textColor="#fdf6e3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnmedio"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btnmedio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#D7701D"
        android:text="home"
        android:textColor="#fdf6e3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn_der"
        app:layout_constraintStart_toEndOf="@+id/btn_izq" />

    <Button
        android:id="@+id/btn_der"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#D7701D"
        android:text="apps"
        android:textColor="#fdf6e3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btnmedio" />

</androidx.constraintlayout.widget.ConstraintLayout>

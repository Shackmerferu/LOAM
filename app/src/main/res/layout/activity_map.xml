<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="#fdf6e3"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.location.MapActivity">

    <!-- HEADER IDÉNTICO A PANTALLA_INICIO -->
    <Button
        android:id="@+id/btn_salir"
        android:layout_width="68dp"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#D7701D"
        android:text="X"
        android:textColor="#fdf6e3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="PreAlertarte"
        android:textColor="#0d0d0d"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="¿Dónde estoy?"
        android:textColor="#555555"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView2" />

    <!-- CONTENEDOR CENTRAL (MISMO TAMAÑO Y CONCEPTO QUE PANTALLA_INICIO) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/btnmedio"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView3">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/scroll_cont"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:paddingHorizontal="8dp"
            android:clipChildren="true">

            <!-- Dirección física en grande -->
            <TextView
                android:id="@+id/tvDireccionGrande"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Obteniendo dirección..."
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#0d0d0d"
                android:gravity="center"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Mapa Web OpenStreetMap Redimensionado -->
            <WebView
                android:id="@+id/mapaWebView"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@+id/tvDireccionGrande"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:ignore="WebViewLayout" />

            <!-- Botón para registrar locación en Firebase -->
            <Button
                android:id="@+id/btnGuardarLocacion"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:text="Registrar Locación de Siniestro"
                android:backgroundTint="#D7701D"
                android:textColor="#fdf6e3"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@+id/mapaWebView"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- FOOTER IDÉNTICO A PANTALLA_INICIO -->
    <Button
        android:id="@+id/btn_izq"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#D7701D"
        android:text="mapa"
        android:textColor="#fdf6e3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnmedio"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btnmedio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#D7701D"
        android:text="home"
        android:textColor="#fdf6e3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn_der"
        app:layout_constraintStart_toEndOf="@+id/btn_izq" />

    <Button
        android:id="@+id/btn_der"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#D7701D"
        android:text="apps"
        android:textColor="#fdf6e3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btnmedio" />

</androidx.constraintlayout.widget.ConstraintLayout>

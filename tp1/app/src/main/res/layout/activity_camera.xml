<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="#fdf6e3"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.navegacion.CameraActivity">

    <!-- HEADER -->
    <Button
        android:id="@+id/btn_salir"
        android:layout_width="68dp"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#D7701D"
        android:text="X"
        android:textColor="#fdf6e3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="PreAlertarte"
        android:textColor="#0d0d0d"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cámara"
        android:textColor="#555555"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView2" />

    <!-- BOTÓN PARA CAMBIAR DE CÁMARA (FRONTAL / TRASERA) -->
    <Button
        android:id="@+id/btnSwitchCamera"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:backgroundTint="#D7701D"
        android:text="Cambiar"
        android:textColor="#fdf6e3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- VISTA PREVIA EN TIEMPO REAL (PREVIEWVIEW) -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintTop_toBottomOf="@+id/textView3"
        app:layout_constraintBottom_toTopOf="@+id/layoutControles"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- CONTENEDOR DE BOTONES DE ACCIÓN (FOTO Y GRABACIÓN) -->
    <LinearLayout
        android:id="@+id/layoutControles"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/btnmedio"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Botón para Tomar Foto -->
        <Button
            android:id="@+id/image_capture_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:backgroundTint="#D7701D"
            android:text="Tomar Foto"
            android:textColor="#fdf6e3"
            android:textStyle="bold" />

        <!-- Botón Dinámico para Grabar / Detener Video -->
        <Button
            android:id="@+id/btnToggleRecord"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#E0E0E0"
            android:drawableTop="@drawable/ic_record"
            android:text="Grabar"
            android:textColor="#333333"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- FOOTER / NAVEGACIÓN INFERIOR -->
    <Button
        android:id="@+id/btn_izq"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#D7701D"
        android:text="mapa"
        android:textColor="#fdf6e3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnmedio"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btnmedio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#D7701D"
        android:text="home"
        android:textColor="#fdf6e3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn_der"
        app:layout_constraintStart_toEndOf="@+id/btn_izq" />

    <Button
        android:id="@+id/btn_der"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#D7701D"
        android:text="apps"
        android:textColor="#fdf6e3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btnmedio" />

</androidx.constraintlayout.widget.ConstraintLayout>